{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "app:app",
      "functions": {
        "app.py": {
          "maxDuration": 300,
          "excludeFiles": "{frontend/**,gateway/**,tests/**,.dist/**,src/federated_flower.py,src/scenarios.py,**/*.ipynb}"
        }
      }
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "npm run build:showcase",
      "outputDirectory": "dist"
    },
    "gateway": {
      "root": "gateway",
      "framework": "express",
      "entrypoint": "index.js",
      "bindings": [
        { "type": "service", "service": "app", "format": "url", "env": "APP_URL" }
      ],
      "functions": {
        "index.js": { "maxDuration": 300 }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "gateway" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
